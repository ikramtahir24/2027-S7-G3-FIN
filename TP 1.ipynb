        "# OR et NOT : clients situés à Casablanca ou Settat,\n",
        "# sauf un client précis.\n",
        "pd.read_sql_query(\"\"\"\n",
        "SELECT nom, ville\n",
        "FROM clients\n",
        "WHERE (ville = 'Casablanca' OR ville = 'Settat')\n",
        "  AND NOT nom = 'Nora Amrani'\n",
        "ORDER BY ville, nom;\n",
        "\"\"\", conn)"

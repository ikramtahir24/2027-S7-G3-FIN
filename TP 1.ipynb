      "source": [
        "pd.read_sql_query(\"\"\"\n",
        "SELECT c.nom, COUNT(co.id_commande) AS nombre_commandes\n",
        "FROM clients AS c\n",
        "JOIN commandes AS co ON c.id_client = co.id_client\n",
        "WHERE co.statut <> 'Annulée'\n",
        "GROUP BY c.id_client, c.nom\n",
        "ORDER BY nombre_commandes DESC, c.nom\n",
        "LIMIT 1;\n",
        "\"\"\", conn)"
      ],
      "id": "zpG6_aarmg-H"
    },

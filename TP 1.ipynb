      "source": [
        "pd.read_sql_query(\"\"\"\n",
        "SELECT\n",
        "    c.nom,\n",
        "    COUNT(co.id_commande) AS nombre_commandes\n",
        "FROM clients AS c\n",
        "LEFT JOIN commandes AS co\n",
        "    ON c.id_client = co.id_client\n",
        "   AND co.statut <> 'Annulée'\n",
        "GROUP BY c.id_client, c.nom\n",
        "ORDER BY nombre_commandes DESC, c.nom;\n",
        "\"\"\", conn)"
      ],
      "id": "3UnqIJg8mg-F"

      "source": [
        "pd.read_sql_query(\"\"\"\n",
        "SELECT\n",
        "    dc.id_commande,\n",
        "    p.nom_produit,\n",
        "    dc.quantite,\n",
        "    dc.prix_unitaire,\n",
        "    ROUND(dc.quantite * dc.prix_unitaire, 2) AS montant_ligne\n",
        "FROM details_commandes AS dc\n",
        "INNER JOIN produits AS p\n",
        "    ON dc.id_produit = p.id_produit\n",
        "ORDER BY dc.id_commande, p.nom_produit;\n",
        "\"\"\", conn)"
      ],
      "id": "U3YwzZA0mg-B"
    },
